# OFF BY DEFAULT since 2026-10-13 (var.create_rds): live stacks run Postgres on
# their own host (db_host.tf, docs/db_on_host.md). Phase B of that plan.
resource "aws_db_subnet_group" "main" {
  count      = var.create_rds ? 1 : 0
  name       = local.name
  subnet_ids = aws_subnet.private[*].id
}

resource "aws_db_instance" "main" {
  count          = var.create_rds ? 1 : 0
  identifier     = local.name
  engine         = "postgres"
  engine_version = "16"
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage_gb
  max_allocated_storage = var.db_allocated_storage_gb * 5
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = "deltabt"
  username = "deltabt"

  # The password is generated by RDS and stored in Secrets Manager. It never
  # appears in Terraform state, in this repository, or in an environment
  # variable -- which is what "do not put the database password in Git"
  # actually requires. The alternative, random_password, writes the secret
  # into state in plaintext.
  manage_master_user_password = true

  # ON, together with the move to db.t4g.small (var.db_instance_class).
  #
  # IAM database authentication needs "between 300 and 1000 MiB extra memory"
  # (AWS). On the old db.t4g.micro, with ~120 MiB free, enabling it on
  # 2026-09-17 pushed swap from ~75 to ~340 MiB and every token login timed out
  # and was denied. It was disabled by CLI the same day.
  #
  # Enabling it changes nothing for password logins, so every bot keeps
  # working. The live image turns DB_IAM_AUTH on in deploy/docker/
  # Dockerfile.live ONLY AFTER this has applied: apply_immediately is false, so
  # the class change and this flag wait for the maintenance window, and an image
  # that asks for tokens before then is refused on every login (#84).
  # tests/live_exec/test_live_db_auth.py holds that ordering.
  iam_database_authentication_enabled = true

  db_subnet_group_name   = aws_db_subnet_group.main[0].name
  vpc_security_group_ids = [aws_security_group.db.id]
  publicly_accessible    = false

  backup_retention_period = var.db_backup_retention_days
  backup_window           = "18:00-19:00" # ~23:30 IST, outside the busiest hours
  maintenance_window      = "sun:19:30-sun:20:30"
  copy_tags_to_snapshot   = true

  # The experiment database is the deliverable. Deleting it by accident loses
  # evidence that cannot be regenerated.
  deletion_protection       = var.db_deletion_protection
  skip_final_snapshot       = false
  final_snapshot_identifier = "${local.name}-final-${formatdate("YYYYMMDDhhmmss", timestamp())}"

  performance_insights_enabled = false # not free on t4g
  auto_minor_version_upgrade   = true
  apply_immediately            = false

  lifecycle {
    # Otherwise every plan shows a diff, because the identifier embeds a
    # timestamp evaluated at plan time.
    ignore_changes = [final_snapshot_identifier]

    # The last line of defence. deletion_protection can be flipped off in one
    # apply; this makes Terraform refuse to plan the destroy at all, so losing
    # a 30-day dataset takes a deliberate code change and a review.
    prevent_destroy = true
  }
}

variable "create_rds" {
  description = "Build the shared RDS instance. Off since 2026-10-13: the bot's Postgres runs on its host."
  type        = bool
  default     = false
}

locals {
  rds_db_name    = var.create_rds ? aws_db_instance.main[0].db_name : "deltabt"
  rds_address    = var.create_rds ? aws_db_instance.main[0].address : ""
  rds_port       = var.create_rds ? aws_db_instance.main[0].port : 5432
  rds_secret_arn = var.create_rds ? aws_db_instance.main[0].master_user_secret[0].secret_arn : ""
}
