# Forward recorder for the perpetual hedge instrument (BTCUSD, ETHUSD).
#
# WHY THIS EXISTS, AND WHY IT IS URGENT
#
#   The options research gate found the gap that blocks H-Vol-6: the cached
#   perpetual 1-minute series ends 2026-08-12 10:52 and the option quote
#   recorder starts 2026-08-24 16:03. ZERO OVERLAP. A delta-hedged option
#   study needs the underlying at the hedge instants, and until this unit runs
#   nothing is recording it -- so the option recorder, however long it runs,
#   accumulates data H-Vol-6 still cannot use.
#
#   The two recorders are only useful TOGETHER. Overlap, not either series
#   alone, is the readiness metric.
#
# WHY 60 SECONDS AND NOT 900
#
#   The hedge grid H-Vol-6 is specified against is 15 minutes, but the raw
#   series must be finer so the experiment can construct that grid itself
#   rather than inherit one. Recording 15-minute bars would bake in a choice
#   the frozen hypothesis is supposed to make.
#
# It is read-only against public endpoints. No API keys, no signing, no order
# path.
#
# Install:
#   sudo cp deltabt-perp-recorder.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now deltabt-perp-recorder
#   journalctl -u deltabt-perp-recorder -f
#
# Storage: 2 symbols x 1440 quote snapshots/day plus ~2,880 1m bars/day is a
# few MB a month -- negligible beside the option surface.

[Unit]
Description=deltabt Delta India perpetual hedge-instrument recorder
Documentation=file:///opt/deltabt/docs/options_data_audit.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deltabt
Group=deltabt
WorkingDirectory=/opt/deltabt

Environment=DELTABT_DATA=/var/lib/deltabt/data
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/deltabt/.venv/bin/python -m deltabt.data.perp_recorder --interval 60

# SIGTERM lets the current poll finish so a partition closes cleanly.
KillSignal=SIGTERM
TimeoutStopSec=60

Restart=always
RestartSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/deltabt/data

[Install]
WantedBy=multi-user.target
